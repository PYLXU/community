<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.ImageViewerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      mc:Ignorable="d"
      Title="{x:Static props:ImageViewerStrings.GroupTitle}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <!-- ===================== 总开关 ===================== -->

                    <TextBlock Text="{x:Static props:ImageViewerStrings.GroupTitle}" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                    <controls:LabeledSettingsCard x:Name="CardImageViewerMaster"
                            Header="{x:Static props:ImageViewerStrings.MasterToggle}"
                            Description="{x:Static props:ImageViewerStrings.MasterToggleHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.Photo}"
                            Toggled="CardImageViewerMaster_Toggled"/>

                    <ui:InfoBar x:Name="InfoBarDisabled"
                            Severity="Warning"
                            IsClosable="False"
                            IsOpen="False"
                            Message="{x:Static props:ImageViewerStrings.DisabledNotice}" />

                    <ui:InfoBar x:Name="InfoBarMessage"
                            Severity="Informational"
                            IsClosable="True"
                            IsOpen="False" />

                    <!-- ===================== 格式绑定 ===================== -->

                    <ui:SettingsExpander x:Name="ExpanderFormats"
                            Header="{x:Static props:ImageViewerStrings.FormatsGroupHeader}"
                            Description="{x:Static props:ImageViewerStrings.FormatsHint}"
                            IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}"
                            IsExpanded="True"
                            d:Visibility="Visible">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenFile}" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:SettingsExpander.Items>

                            <ui:SettingsCard x:Name="CardFormatList" ContentAlignment="Left">
                                <ikw:SimpleStackPanel x:Name="FormatListPanel" Spacing="2" MinWidth="320" />
                            </ui:SettingsCard>

                            <ui:SettingsCard ContentAlignment="Left">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BtnSelectAllFormats"
                                            Content="{x:Static props:ImageViewerStrings.SelectAllCommon}"
                                            Click="BtnSelectAllFormats_Click" />
                                    <Button x:Name="BtnClearAllFormats"
                                            Content="{x:Static props:ImageViewerStrings.ClearAll}"
                                            Click="BtnClearAllFormats_Click" />
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{x:Static props:ImageViewerStrings.CustomFormatHeader}"
                                    Description="{x:Static props:ImageViewerStrings.CustomFormatDescription}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="TextBoxCustomFormat"
                                             Width="130"
                                             KeyDown="TextBoxCustomFormat_KeyDown" />
                                    <Button x:Name="BtnAddCustomFormat"
                                            Content="{x:Static props:ImageViewerStrings.AddCustomFormat}"
                                            Click="BtnAddCustomFormat_Click" />
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>

                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <!-- ===================== 系统关联 ===================== -->

                    <ui:SettingsExpander x:Name="ExpanderFileAssociation"
                            Header="{x:Static props:ImageViewerStrings.AssociationGroupHeader}"
                            Description="{x:Static props:ImageViewerStrings.RegisterFileAssociationHint}"
                            IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}"
                            IsExpanded="True">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Link}" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:SettingsExpander.Items>

                            <ui:SettingsCard Header="{x:Static props:ImageViewerStrings.RegisterFileAssociation}"
                                    IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Link}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch x:Name="CardRegisterFileAssociation"
                                                 Toggled="CardRegisterFileAssociation_Toggled" />
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{x:Static props:ImageViewerStrings.AssociationStatusHeader}"
                                    Description="{x:Static props:ImageViewerStrings.DefaultAppHint}"
                                    IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.PreviewLink}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BtnApplyAssociation"
                                            Content="{x:Static props:ImageViewerStrings.ApplyAssociation}"
                                            Click="BtnApplyAssociation_Click" />
                                    <Button x:Name="BtnRemoveAssociation"
                                            Content="{x:Static props:ImageViewerStrings.RemoveAssociation}"
                                            Click="BtnRemoveAssociation_Click" />
                                    <Button x:Name="BtnOpenDefaultApps"
                                            Content="{x:Static props:ImageViewerStrings.OpenDefaultApps}"
                                            Click="BtnOpenDefaultApps_Click" />
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>

                            <ui:SettingsCard ContentAlignment="Left"
                                    IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}">
                                <TextBlock x:Name="TextAssociationStatus" TextWrapping="Wrap" MaxWidth="620" />
                            </ui:SettingsCard>

                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <!-- ===================== 查看器窗口 ===================== -->

                    <ui:SettingsExpander x:Name="ExpanderViewerWindow"
                            Header="{x:Static props:ImageViewerStrings.ViewerGroupHeader}"
                            IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}"
                            IsExpanded="True">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.View}" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:SettingsExpander.Items>

                            <ui:SettingsCard Header="{x:Static props:ImageViewerStrings.MultiInstance}"
                                    Description="{x:Static props:ImageViewerStrings.MultiInstanceHint}"
                                    IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ViewAll}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch x:Name="CardMultiInstance"
                                                 Toggled="CardMultiInstance_Toggled" />
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{x:Static props:ImageViewerStrings.ShowInTaskbar}"
                                    Description="{x:Static props:ImageViewerStrings.ShowInTaskbarHint}"
                                    IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pin}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch x:Name="CardShowInTaskbar"
                                                 Toggled="CardShowInTaskbar_Toggled" />
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{x:Static props:ImageViewerStrings.RememberWindowPlacement}"
                                    Description="{x:Static props:ImageViewerStrings.RememberWindowPlacementHint}"
                                    IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.History}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch x:Name="CardRememberWindowPlacement"
                                                 Toggled="CardRememberWindowPlacement_Toggled" />
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{x:Static props:ImageViewerStrings.OpenFitToWindow}"
                                    Description="{x:Static props:ImageViewerStrings.OpenFitToWindowHint}"
                                    IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Zoom}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch x:Name="CardOpenFitToWindow"
                                                 Toggled="CardOpenFitToWindow_Toggled" />
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{x:Static props:ImageViewerStrings.AutoSaveAnnotations}"
                                    Description="{x:Static props:ImageViewerStrings.AutoSaveAnnotationsHint}"
                                    IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Save}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch x:Name="CardAutoSaveAnnotations"
                                                 Toggled="CardAutoSaveAnnotations_Toggled" />
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{x:Static props:ImageViewerStrings.BackgroundColor}"
                                    Description="{x:Static props:ImageViewerStrings.BackgroundColorHint}"
                                    IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Color}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <Border x:Name="BorderBackgroundColorPreview"
                                            Width="28" Height="28" CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <Button x:Name="BtnPickBackgroundColor"
                                            Content="{x:Static props:ImageViewerStrings.BackgroundColor}"
                                            Click="BtnPickBackgroundColor_Click" />
                                    <Button x:Name="BtnResetBackgroundColor"
                                            Content="{x:Static props:ImageViewerStrings.ResetToDefault}"
                                            ToolTipService.ToolTip="{x:Static props:ImageViewerStrings.ResetBackgroundColorHint}"
                                            Click="BtnResetBackgroundColor_Click" />
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>

                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <!-- ===================== 测试 ===================== -->

                    <ui:SettingsCard Header="{x:Static props:ImageViewerStrings.TestOpenImage}"
                            IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Send}" />
                        </ui:SettingsCard.HeaderIcon>
                        <Button x:Name="BtnTestOpenImage"
                                Content="{x:Static props:ImageViewerStrings.TestOpenImage}"
                                IsEnabled="{Binding IsOn, ElementName=CardImageViewerMaster}"
                                Click="BtnTestOpenImage_Click" />
                    </ui:SettingsCard>

                    <Rectangle Height="48" />
                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
