<Window x:Class="Ink_Canvas.Windows.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:props="clr-namespace:Ink_Canvas.Properties"
        xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
        xmlns:cv="clr-namespace:Ink_Canvas.Controls"
        mc:Ignorable="d"
        Title="{x:Static props:ImageViewerStrings.WindowTitleSuffix}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        MinWidth="420"
        MinHeight="300"
        Width="1180"
        Height="800"
        Background="#FF1E1E1E"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Resources/icc.ico">

    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- 橡皮擦擦头图片资源：与主画布（MainWindow.xaml）合并的是同一个文件，
                 因此查看器里的擦头与主画布/UI 联动画布完全同款。 -->
            <ResourceDictionary Source="/InkCanvasForClass;component/MainWindow_cs/MW_Eraser.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- 底栏按钮：图标在上、文字说明在下；无边框、悬浮/按下高亮。
             尺寸按触摸屏取值（最小 60×54），手指点得到。 -->
        <Style x:Key="ViewerBarButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Foreground" Value="#FFF2F2F2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「墨迹书写」按钮：进入批注状态时用强调色高亮（代码里改 Background / BorderBrush） -->
        <Style x:Key="ViewerBarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerBarButtonStyle}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
        </Style>

        <!-- 关闭按钮：悬浮时红色（Windows 惯例） -->
        <Style x:Key="ViewerBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#A02316" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏按钮：贴近系统标题栏的紧凑尺寸，无文字说明 -->
        <Style x:Key="ViewerTitleBarButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerTitleBarCloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ViewerTitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#A02316" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底栏按钮组之间的竖分隔线 -->
        <Style x:Key="ViewerBarSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="7,0" />
            <Setter Property="Fill" Value="#33FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 图像调整滑杆（触摸友好：滑杆本身由 SliderTouchHelper 接管触摸/手写笔） -->
        <Style x:Key="ViewerAdjustLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="46" />
        </Style>

        <Style x:Key="ViewerAdjustValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFBFBFBF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="38" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

      </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderThickness="1"
            BorderBrush="#33FFFFFF"
            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===================== 标题栏 ===================== -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Height="40"
                    Background="#F2141414"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：图片查看器专属图标 + 「文件名 - Ink Canvas 图片查看器」 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                        <Image x:Name="TitleBarIcon" Width="18" Height="18" IsHitTestVisible="False" />
                        <TextBlock x:Name="TextTitleBar"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FFF2F2F2"
                                   FontSize="12.5"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False" />
                    </StackPanel>

                    <!-- 中：空白拖动区（真正拖动窗口靠 WM_NCHITTEST 判成 HTCAPTION） -->
                    <Border Grid.Column="1" Background="Transparent" />

                    <!-- 右：最小化 / 最大化 / 关闭 -->
                    <StackPanel x:Name="TitleBarButtonGroup" Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 图片 + 批注画布 -->
            <cv:ImageViewerCanvas x:Name="ViewerCanvas" Grid.Row="1" ClipToBounds="True" />

            <!-- 左下角状态浮层（像素尺寸 / 缩放 / 序号；文件名已在标题栏） -->
            <Border x:Name="InfoOverlay"
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="12,0,0,12"
                    Padding="10,6"
                    CornerRadius="6"
                    Background="#B3000000"
                    IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="TextInfoTitle"
                               Foreground="#FFF2F2F2"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="520" />
                    <TextBlock x:Name="TextInfoDetail"
                               Foreground="#FFB9B9B9"
                               FontSize="11"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- 右下角缩放手柄（纯视觉提示，真正的缩放命中在 WM_NCHITTEST 里） -->
            <Path x:Name="ResizeGrip"
                  Grid.Row="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,3,3"
                  Fill="#59FFFFFF"
                  IsHitTestVisible="False"
                  Data="M 12,0 L 0,12 L 0,9 L 9,0 Z M 12,5 L 5,12 L 8,12 L 12,8 Z" />

            <!-- 全屏下的退出按钮：全屏会隐藏标题栏与底栏，必须显式留一个出口，
                 否则用户只能靠 Esc，一旦窗口没拿到键盘焦点就等于「进得去出不来」。 -->
            <Button x:Name="BtnExitFullScreen"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,12,0"
                    Padding="12,6"
                    Background="#CC000000"
                    BorderBrush="#59FFFFFF"
                    Visibility="Collapsed"
                    AutomationProperties.Name="{x:Static props:ImageViewerStrings.BarExitFullScreen}"
                    AutomationProperties.HelpText="{x:Static props:ImageViewerStrings.FullScreenExitHint}"
                    Style="{StaticResource ViewerBarToggleButtonStyle}"
                    Click="BtnExitFullScreen_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73F;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                               FontSize="14" Foreground="#FFF2F2F2" VerticalAlignment="Center" />
                    <TextBlock x:Name="TextExitFullScreen"
                               Margin="6,0,0,0" FontSize="12" Foreground="#FFF2F2F2"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- ===================== 底部扩展栏 ===================== -->
            <Border x:Name="BottomBar"
                    Grid.Row="2"
                    Height="62"
                    Background="#F2141414"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="LeftButtonGroup" Grid.Column="0"
                                Orientation="Horizontal" Margin="8,0,0,0"
                                VerticalAlignment="Center" />

                    <StackPanel x:Name="CenterButtonGroup" Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                    <StackPanel x:Name="RightButtonGroup" Grid.Column="2"
                                Orientation="Horizontal" Margin="0,0,8,0"
                                VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 图像调整面板（锚到底栏的「图像调整」按钮上方） -->
            <Popup x:Name="AdjustPopup"
                   Grid.Row="2"
                   Placement="Top"
                   VerticalOffset="-6"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade">
                <Border Background="#F21F1F1F"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel Width="280">
                        <TextBlock Text="{x:Static props:ImageViewerStrings.AdjustTitle}"
                                   Foreground="#FFF2F2F2"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{x:Static props:ImageViewerStrings.AdjustBrightness}"
                                       Style="{StaticResource ViewerAdjustLabelStyle}" />
                            <Slider x:Name="SliderBrightness" Grid.Row="0" Grid.Column="1"
                                    Minimum="-100" Maximum="100" Value="0"
                                    Margin="6,0"
                                    ValueChanged="AdjustSlider_ValueChanged" />
                            <TextBlock x:Name="TextBrightness" Grid.Row="0" Grid.Column="2"
                                       Style="{StaticResource ViewerAdjustValueStyle}" Text="0" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{x:Static props:ImageViewerStrings.AdjustContrast}"
                                       Style="{StaticResource ViewerAdjustLabelStyle}"
                                       Margin="0,6,0,0" />
                            <Slider x:Name="SliderContrast" Grid.Row="1" Grid.Column="1"
                                    Minimum="-100" Maximum="100" Value="0"
                                    Margin="6,6,6,0"
                                    ValueChanged="AdjustSlider_ValueChanged" />
                            <TextBlock x:Name="TextContrast" Grid.Row="1" Grid.Column="2"
                                       Style="{StaticResource ViewerAdjustValueStyle}"
                                       Text="0" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="{x:Static props:ImageViewerStrings.AdjustSaturation}"
                                       Style="{StaticResource ViewerAdjustLabelStyle}"
                                       Margin="0,6,0,0" />
                            <Slider x:Name="SliderSaturation" Grid.Row="2" Grid.Column="1"
                                    Minimum="-100" Maximum="100" Value="0"
                                    Margin="6,6,6,0"
                                    ValueChanged="AdjustSlider_ValueChanged" />
                            <TextBlock x:Name="TextSaturation" Grid.Row="2" Grid.Column="2"
                                       Style="{StaticResource ViewerAdjustValueStyle}"
                                       Text="0" Margin="0,6,0,0" />
                        </Grid>

                        <Button x:Name="BtnAdjustReset"
                                Content="{x:Static props:ImageViewerStrings.AdjustReset}"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0"
                                MinWidth="72"
                                Click="BtnAdjustReset_Click" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
